        "siege_green": {
          "default": 0,
          "title": "Siege Green",
          "type": "integer"
        },
        "bypass_yellow": {
          "default": false,
          "title": "Bypass Yellow",
          "type": "boolean"
        },
        "bypass_green": {
          "default": false,
          "title": "Bypass Green",
          "type": "boolean"
