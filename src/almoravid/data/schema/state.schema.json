    "Lord": {
      "additionalProperties": false,
      "description": "A Lord (Christian or Muslim).\n\nPer-flag scope conventions (Pattern 3 / SMOKE-001, 035, 036, 037, 095):\n    moved_fought:            scope = per-Levy\n    just_arrived_this_levy:  scope = per-Levy (reset on Levy->Campaign->Levy)\n    lordship_used:           scope = per-card (Muster segment)\n    in_stronghold:           scope = lifecycle (cleared on move / re-Muster)\n    routed_units:            scope = per-engagement (cleared on aftermath)\n    first_march_used_this_card: scope = per-card\n    raiders_used_this_card:  scope = per-card\n\nLifecycle cleanup contract (Pattern 8 / SMOKE-033, 038, 087, 088, 095):\n`Lord.cleanup_on_removal_fields` lists every field that MUST be\ncleared when this Lord is permanently removed OR Disbanded at limit.\nRemoval handlers added in later phases must consult this list.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "side": {
          "enum": [
            "christian",
            "muslim"
          ],
          "title": "Side",
          "type": "string"
        },
        "is_taifa": {
          "default": false,
          "title": "Is Taifa",
          "type": "boolean"
        },
        "home_taifa": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Home Taifa"
        },
        "seats": {
          "items": {
            "type": "string"
          },
          "title": "Seats",
          "type": "array"
        },
        "fealty": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
