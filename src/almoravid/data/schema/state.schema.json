          "type": "integer"
        },
        "lordship_rating": {
          "title": "Lordship Rating",
          "type": "integer"
        },
        "command_rating": {
          "title": "Command Rating",
          "type": "integer"
        },
        "cylinder": {
          "$ref": "#/$defs/Cylinder"
