    "PendingDecision": {
      "additionalProperties": false,
      "description": "A response/choice owed by some side before play can continue.\n\nPhase 0 scaffold. Phase 2+ will populate `kind` with action-specific\ndiscriminators (battle strike select, siege response, event target\npick, etc.) and may turn this into a discriminated union.\n\nPattern 11 (active-player desync): when `pending` is set, the side\nin `waiting_on` must equal `Meta.active_player`. Tests should\nassert this invariant.",
      "properties": {
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "waiting_on": {
          "enum": [
            "christian",
            "muslim"
          ],
          "title": "Waiting On",
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        }
      },
      "required": [
        "kind",
        "waiting_on"
      ],
      "title": "PendingDecision",
