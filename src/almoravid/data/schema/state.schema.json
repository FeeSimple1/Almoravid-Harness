{
  "$defs": {
    "Calendar": {
      "additionalProperties": false,
      "description": "The 16-box Calendar plus off-edge lanes.\n\nOff-edge lanes are separate for cylinders vs Service markers\n(Pattern 6 / SMOKE-057). Do NOT merge.",
      "properties": {
        "boxes": {
          "items": {
            "$ref": "#/$defs/CalendarBox"
          },
          "title": "Boxes",
          "type": "array"
        },
        "current_box": {
          "default": 1,
          "title": "Current Box",
          "type": "integer"
        },
        "off_left": {
          "items": {
            "type": "string"
          },
          "title": "Off Left",
          "type": "array"
        },
        "off_right": {
          "items": {
            "type": "string"
          },
          "title": "Off Right",
          "type": "array"
        },
        "service_markers": {
          "items": {
            "$ref": "#/$defs/ServiceMarker"
          },
          "title": "Service Markers",
          "type": "array"
        },
        "off_left_service": {
          "items": {
            "type": "string"
          },
          "title": "Off Left Service",
          "type": "array"
        },
        "off_right_service": {
          "items": {
            "type": "string"
          },
          "title": "Off Right Service",
          "type": "array"
        }
      },
      "required": [
        "boxes"
      ],
      "title": "Calendar",
      "type": "object"
    },
    "CalendarBox": {
      "additionalProperties": false,
      "description": "One box on the 16-box Calendar.",
      "properties": {
        "number": {
          "title": "Number",
          "type": "integer"
        },
        "season": {
          "enum": [
            "spring",
            "summer",
            "autumn",
            "winter"
          ],
          "title": "Season",
          "type": "string"
        },
        "turn_type": {
          "enum": [
            "levy",
            "campaign",
            "curias",
            "winter"
          ],
