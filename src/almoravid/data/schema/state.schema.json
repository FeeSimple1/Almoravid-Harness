            "type": "array"
          },
          "propertyNames": {
            "enum": [
              "christian",
              "muslim"
            ]
          },
          "title": "Plan",
          "type": "object"
        }
      },
      "title": "Decks",
      "type": "object"
    },
    "HistoryEntry": {
      "additionalProperties": false,
      "description": "One action recorded in the game history log.",
      "properties": {
        "turn_index": {
          "title": "Turn Index",
          "type": "integer"
        },
        "actor": {
          "anyOf": [
            {
              "enum": [
                "christian",
                "muslim"
              ],
              "type": "string"
            },
            {
              "const": "system",
              "type": "string"
            }
          ],
          "title": "Actor"
        },
        "action": {
          "title": "Action",
          "type": "string"
        },
        "args": {
          "additionalProperties": true,
          "title": "Args",
          "type": "object"
        },
        "summary": {
          "default": "",
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "turn_index",
        "actor",
        "action"
      ],
      "title": "HistoryEntry",
      "type": "object"
    },
    "Locale": {
      "additionalProperties": false,
      "description": "A map location.\n\n`base_type` is fixed at scenario setup. Overlay state (Conquered,\nJihad, Seat, Siege, Bypass, Ravaged) lives in separate fields and\nis queried via Phase 1 `effective_*` helpers (Pattern 5 / SMOKE-040,\n054, 065, 066, 073-077).",
