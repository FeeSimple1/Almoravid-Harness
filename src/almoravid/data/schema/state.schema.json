          "items": {
            "type": "string"
          },
          "title": "Cylinder Lord Ids",
          "type": "array"
        },
        "decorations": {
          "items": {
            "type": "string"
          },
          "title": "Decorations",
          "type": "array"
        }
      },
      "required": [
        "number",
        "season",
        "turn_type"
      ],
      "title": "CalendarBox",
      "type": "object"
    },
    "CardInPlay": {
      "additionalProperties": false,
      "description": "An Arts of War card currently in play.\n\n`scope` enforces the this_lord vs side_wide distinction\n(Pattern 14 / SMOKE-016). Helpers in Phase 4 must filter on this.",
      "properties": {
        "card_id": {
          "title": "Card Id",
          "type": "string"
        },
        "scope": {
          "enum": [
            "this_lord",
            "side_wide"
          ],
          "title": "Scope",
          "type": "string"
        },
        "owner_side": {
          "enum": [
            "christian",
            "muslim"
          ],
          "title": "Owner Side",
          "type": "string"
        },
        "owner_lord_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner Lord Id"
        }
      },
      "required": [
        "card_id",
        "scope",
        "owner_side"
      ],
      "title": "CardInPlay",
      "type": "object"
    },
    "Cylinder": {
      "additionalProperties": false,
      "description": "Where a Lord's cylinder currently is.\n\nValidation that (kind, box, locale_id) are consistent is deferred\nto Phase 1. Phase 0 just records the shape.",
      "properties": {
        "kind": {
          "enum": [
            "calendar",
            "locale",
            "mat",
            "set_aside",
            "removed"
          ],
          "title": "Kind",
          "type": "string"
        },
        "box": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Box"
        },
        "locale_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locale Id"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Cylinder",
      "type": "object"
    },
    "Decks": {
      "additionalProperties": false,
      "description": "Arts of War deck state.\n\n`capabilities_in_play` holds side-wide-scope cards (Pattern 14).\nThis-lord-scope cards live on `Lord.capabilities`.\n\n`this_levy_events` and `this_campaign_events` are the persistence\nbuckets for hold-events drawn this turn (cleared at the relevant\nwindow boundary per Pattern 13).",
      "properties": {
        "draw": {
          "items": {
            "type": "string"
          },
          "title": "Draw",
          "type": "array"
        },
        "discard": {
          "items": {
            "type": "string"
          },
          "title": "Discard",
          "type": "array"
        },
        "held": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "propertyNames": {
            "enum": [
              "christian",
              "muslim"
            ]
          },
          "title": "Held",
          "type": "object"
        },
        "capabilities_in_play": {
          "items": {
            "$ref": "#/$defs/CardInPlay"
          },
          "title": "Capabilities In Play",
          "type": "array"
        },
        "board_edge": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "propertyNames": {
            "enum": [
              "christian",
              "muslim"
            ]
          },
          "title": "Board Edge",
          "type": "object"
        },
        "this_levy_events": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "propertyNames": {
            "enum": [
              "christian",
              "muslim"
            ]
          },
          "title": "This Levy Events",
          "type": "object"
        },
        "this_campaign_events": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "propertyNames": {
            "enum": [
              "christian",
              "muslim"
            ]
          },
          "title": "This Campaign Events",
          "type": "object"
        },
        "pending_draw": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "propertyNames": {
            "enum": [
              "christian",
              "muslim"
            ]
          },
