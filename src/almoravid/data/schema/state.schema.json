              "coin",
              "loot",
              "prov",
              "cart",
              "mule"
            ]
          },
          "title": "Assets",
          "type": "object"
        },
        "capabilities": {
          "items": {
            "type": "string"
          },
          "title": "Capabilities",
          "type": "array"
        },
        "vassals": {
          "items": {
            "$ref": "#/$defs/Vassal"
          },
          "title": "Vassals",
          "type": "array"
        },
        "in_stronghold": {
          "default": false,
          "title": "In Stronghold",
          "type": "boolean"
        },
        "moved_fought": {
          "default": false,
          "title": "Moved Fought",
          "type": "boolean"
        },
        "just_arrived_this_levy": {
          "default": false,
          "title": "Just Arrived This Levy",
          "type": "boolean"
        },
        "lordship_used": {
          "default": 0,
          "title": "Lordship Used",
          "type": "integer"
        },
        "first_march_used_this_card": {
